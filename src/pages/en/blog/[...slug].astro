---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { readingTimeFromText } from '@/utils/reading-time';
import {
  isPublished,
  getDraftPreviewEntries,
  getDraftSlugParam,
} from '@/utils/content';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const published = all.filter((entry) => isPublished(entry, 'en'));
  const sorted = [...published].sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );

  const publishedRoutes = published.map((post) => {
    const idx = sorted.findIndex((p) => p.id === post.id);
    const nextPosts = [sorted[idx + 1], sorted[idx - 1]].filter(
      (p): p is CollectionEntry<'blog'> => Boolean(p)
    );
    return {
      params: { slug: post.id },
      props: { post, nextPosts, isDraftPreview: false },
    };
  });

  const draftRoutes = getDraftPreviewEntries(all, 'en')
    .map((post) => {
      const slug = getDraftSlugParam(post.id);
      if (!slug) return null;
      return {
        params: { slug },
        props: { post, nextPosts: [], isDraftPreview: true },
      };
    })
    .filter(
      (r): r is NonNullable<typeof r> => r !== null
    );

  return [...publishedRoutes, ...draftRoutes];
}

type Props = {
  post: CollectionEntry<'blog'>;
  nextPosts: CollectionEntry<'blog'>[];
  isDraftPreview: boolean;
};
const { post, nextPosts, isDraftPreview } = Astro.props as Props;

const { Content, headings } = await render(post);

if (!post.data.readingTime && post.body) {
  post.data.readingTime = readingTimeFromText(post.body);
}
---

<ArticleLayout
  post={post}
  nextPosts={nextPosts}
  headings={headings}
  isDraftPreview={isDraftPreview}
>
  <Content />
</ArticleLayout>
