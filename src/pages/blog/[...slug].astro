---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { readingTimeFromText } from '@/utils/reading-time';
import { buildBlogStaticPaths } from '@/utils/static-paths';
import type { SeriesContext } from '@/utils/series';

export async function getStaticPaths() {
  return buildBlogStaticPaths('fr');
}

type Props = {
  post: CollectionEntry<'blog'>;
  nextPosts: CollectionEntry<'blog'>[];
  seriesContext: SeriesContext | null;
  isDraftPreview: boolean;
};
const { post, nextPosts, seriesContext, isDraftPreview } = Astro.props as Props;

const { Content, headings } = await render(post);

if (!post.data.readingTime && post.body) {
  post.data.readingTime = readingTimeFromText(post.body);
}
---

<ArticleLayout
  post={post}
  nextPosts={nextPosts}
  seriesContext={seriesContext}
  headings={headings}
  isDraftPreview={isDraftPreview}
>
  <Content />
</ArticleLayout>
