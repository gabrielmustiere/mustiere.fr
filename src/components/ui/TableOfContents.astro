---
import type { MarkdownHeading } from 'astro';

type Accent = 'blog' | 'projects';

interface Props {
  headings: MarkdownHeading[];
  title: string;
  accent: Accent;
  minHeadings?: number;
  maxDepth?: number;
}

const { headings, title, accent, minHeadings = 3, maxDepth = 3 } = Astro.props;

const filtered = headings.filter(
  (h) => h.depth >= 2 && h.depth <= maxDepth && h.slug && h.text
);
let h2Counter = 0;
const numbered = filtered.map((h) => ({
  ...h,
  number: h.depth === 2 ? ++h2Counter : null,
}));
// Le sommaire a son identité propre (ocre doré --a-cv) plutôt que l'accent
// de la collection : il signale une fonction de navigation, pas un panneau
// éditorial. Les liens conservent l'accent du contenu au hover, cohérent
// avec le reste de l'article.
const tocAccent = 'var(--a-cv)';
const accentVar = accent === 'blog' ? 'var(--a-blog)' : 'var(--a-projects)';

const showToc = filtered.length >= minHeadings;
---

{
  showToc && (
    <details
      open
      class="toc mt-8 pl-4 sm:pl-5 py-1"
      style={`border-left: 2px solid ${tocAccent}; color: ${tocAccent}`}
      aria-labelledby="toc-title"
    >
      <summary
        id="toc-title"
        class="toc__summary not-italic font-mono uppercase tracking-[0.14em] text-[10px] mb-3 cursor-pointer list-none flex items-center gap-2"
        style={`color: ${tocAccent}`}
      >
        <span class="toc__caret" aria-hidden="true">
          ▾
        </span>
        § {title}
      </summary>
      <ol class="list-none p-0 m-0 space-y-1.5 text-[14px] leading-[1.55] tnum">
        {numbered.map((h) => (
          <li
            class={h.depth === 3 ? 'pl-4' : ''}
            style={
              h.depth === 3
                ? 'border-left: 1px solid var(--color-rule); margin-left: 0.25rem'
                : ''
            }
          >
            <a
              href={`#${h.slug}`}
              class="text-[color:var(--color-ink)] hover:text-[color:var(--related-accent,inherit)] transition-colors"
              style={`--related-accent: ${accentVar}`}
            >
              {h.number !== null && (
                <span class="text-[color:var(--color-muted)] font-mono mr-2 tnum text-[11px]">
                  {String(h.number).padStart(2, '0')}
                </span>
              )}
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  .toc__summary::-webkit-details-marker {
    display: none;
  }
  .toc__caret {
    display: inline-block;
    transition: transform 150ms ease;
    font-size: 9px;
  }
  details:not([open]) .toc__caret {
    transform: rotate(-90deg);
  }
</style>
