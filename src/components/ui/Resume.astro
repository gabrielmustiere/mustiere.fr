---
type Accent = 'blog' | 'projects';

interface Props {
  html: string;
  label: string;
  accent: Accent;
  ariaLabel?: string;
}

const { html, label, accent, ariaLabel } = Astro.props;
const accentVar = accent === 'blog' ? 'var(--a-blog)' : 'var(--a-projects)';
---

<aside
  class="resume mt-8 p-5 sm:p-6 text-[16px] sm:text-[17px] leading-[1.6] text-ink-soft"
  style={`border-left: 3px solid ${accentVar}; background: color-mix(in oklch, ${accentVar} 9%, transparent)`}
  aria-label={ariaLabel ?? label}
>
  <span
    class="not-italic font-mono uppercase tracking-[0.14em] text-[10px] text-[color:var(--color-muted)] block mb-2.5"
  >
    {label}
  </span>
  <div data-speakable set:html={html} />
</aside>

<style>
  .resume :global(p) {
    margin: 0 0 0.6em 0;
  }
  .resume :global(p:last-child) {
    margin-bottom: 0;
  }
  .resume :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .resume :global(strong) {
    font-weight: 600;
  }
  .resume :global(em) {
    font-style: italic;
  }
  .resume :global(code) {
    background: var(--color-code-bg);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    padding: 1px 5px;
    font-family: var(--font-mono);
    font-size: 0.88em;
    font-variant-ligatures: none;
    font-feature-settings:
      'liga' 0,
      'calt' 0;
  }
  .resume :global(ul),
  .resume :global(ol) {
    margin: 0.4em 0 0.8em;
    padding-left: 1.4em;
  }
  .resume :global(ul) {
    list-style: none;
  }
  .resume :global(ul li) {
    position: relative;
    margin: 0.25em 0;
  }
  .resume :global(ul li::before) {
    content: '';
    position: absolute;
    left: -1em;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .resume :global(ol) {
    list-style: decimal outside;
  }
  .resume :global(ol li) {
    margin: 0.25em 0;
    padding-left: 0.2em;
  }
  .resume :global(ol li::marker) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  .resume :global(blockquote) {
    margin: 0.6em 0;
    padding-left: 0.9em;
    border-left: 2px solid var(--color-rule);
    font-style: italic;
  }
  .resume :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin: 0.8em 0;
  }
</style>
