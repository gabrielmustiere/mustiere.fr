---
import SiteLayout from '@layouts/SiteLayout.astro';
import Footer from '@components/layout/Footer.astro';
import ArticleCard from '@components/ui/ArticleCard.astro';
import StructuredData from '@components/seo/StructuredData.astro';
import HeroFR from '@components/i18n/blog-archive/hero/fr.astro';
import HeroEN from '@components/i18n/blog-archive/hero/en.astro';
import IntroFR from '@components/i18n/blog-archive/intro/fr.astro';
import IntroEN from '@components/i18n/blog-archive/intro/en.astro';
import { getCollection } from 'astro:content';
import { blogSchema, breadcrumbSchema } from '@/utils/schema';
import { SITE } from '@/consts';
import type { Category } from '@/content.config';
import { useTranslations, localizedPath } from '@/i18n/utils';
import { routePath } from '@/i18n/routes';
import { BLOG_CATEGORIES } from '@/i18n/ui';
import type { Lang } from '@/i18n/config';
import { isPublished } from '@/utils/content';
import { buildSeriesIndex, sortArchive } from '@/utils/series';
import type { CollectionEntry } from 'astro:content';
import type { LangComponents } from '@/i18n/components';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = useTranslations(lang);
const blogHref = localizedPath(lang, '/blog');
const homeHref = localizedPath(lang, '/');
const rssHref = routePath('rssFeed', lang);

// Charger toutes les entrées blog une seule fois pour pouvoir calculer les
// contextes de série en un seul passage (évite N+1 sur la grille d'archive).
const allBlogEntries = await getCollection('blog');
const allSeries = await getCollection('series');

// Index série pré-calculé : `isVisible` aligne la visibilité sur `isPublished`
// (DEV / SHOW_DRAFTS) pour que le compteur N/M et le chip restent cohérents
// avec les cards effectivement affichées.
const seriesIndex = buildSeriesIndex(allBlogEntries, allSeries, {
  isVisible: (a) => isPublished(a as CollectionEntry<'blog'>, lang),
});

// Tri archive : regroupement par série (bucketDate = max publishedAt du
// groupe) puis seriesOrder DESC dans le bloc — dernier épisode en haut.
// Cf. sortArchive() dans @/utils/series.
const all = sortArchive(
  allBlogEntries.filter((entry) => isPublished(entry, lang)),
  seriesIndex
);

const totalCount = all.length;

const categories: Category[] = ['IA', 'Tech', 'Lead', 'Business'];

const countLabel =
  totalCount === 0
    ? tr.blogIndex.countZero
    : totalCount === 1
      ? tr.blogIndex.countSingular
      : tr.blogIndex.countPlural.replace('{n}', String(totalCount));

const description = tr.blogIndex.metaDescription.replace('{count}', countLabel);

const countSuffix =
  totalCount > 1
    ? tr.blogIndex.countSuffixPlural
    : tr.blogIndex.countSuffixSingular;

const HERO: LangComponents = { fr: HeroFR, en: HeroEN };
const INTRO: LangComponents = { fr: IntroFR, en: IntroEN };
const Hero = HERO[lang];
const Intro = INTRO[lang];
---

<SiteLayout
  title={tr.blogIndex.heading}
  description={description}
  type="website"
  current="blog"
  lang={lang}
>
  <StructuredData
    slot="head"
    schemas={[
      blogSchema(lang),
      breadcrumbSchema([
        {
          name: tr.breadcrumb.home,
          url: `${SITE.url}${homeHref}`,
        },
        { name: tr.home.blog.title, url: `${SITE.url}${blogHref}` },
      ]),
    ]}
  />

  <main
    id="main"
    class="mx-auto px-6 sm:px-10 pt-10 sm:pt-16 pb-20"
    style="max-width: var(--w-blog)"
  >
    <nav
      class="mb-6 text-[11px] tracking-[0.12em] uppercase text-[color:var(--color-muted)] flex items-center gap-2 font-mono"
      aria-label={tr.breadcrumb.ariaLabel}
    >
      <a href={homeHref} class="hover:text-[color:var(--color-ink)]">
        {tr.breadcrumb.home}
      </a>
      <span class="text-[color:var(--color-rule-strong)]" aria-hidden="true"
        >/</span
      >
      <span class="acc-blog">{tr.home.blog.title}</span>
    </nav>
    <div
      class="flex items-center justify-between text-[11px] tracking-[0.12em] uppercase font-mono"
    >
      <span class="acc-blog"
        ><span class="acc-dot"></span>§ 02 · {tr.home.blog.title}</span
      >
      <span class="flex items-center gap-3 text-[color:var(--color-muted)]">
        <span class="tnum">
          {totalCount}
          {countSuffix}
        </span>
        <span aria-hidden="true">·</span>
        <a
          href={rssHref}
          class="rss-link inline-flex items-center gap-1.5 hover:text-[color:var(--color-ink)] focus-visible:text-[color:var(--color-ink)]"
          aria-label={tr.blogIndex.rssAriaLabel}
          type="application/rss+xml"
        >
          <svg
            viewBox="0 0 24 24"
            width="11"
            height="11"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM4 4.44v3.18A12.38 12.38 0 0 1 16.38 20h3.18A15.56 15.56 0 0 0 4 4.44zM4 10.1v3.16A6.74 6.74 0 0 1 10.74 20h3.16A9.9 9.9 0 0 0 4 10.1z"
            ></path>
          </svg>
          <span>{tr.blogIndex.rssLabel}</span>
        </a>
      </span>
    </div>

    <Hero />

    <Intro />

    <div
      class="mt-10 flex flex-wrap items-center gap-2"
      id="filters"
      role="group"
      aria-label={tr.blogIndex.filterLabel}
    >
      <button
        type="button"
        data-tag="all"
        class="cat-pill text-[color:var(--color-ink)] chip-active"
        aria-pressed="true"
      >
        <span>{tr.blogIndex.allCategories}</span>
      </button>
      {
        categories.map((cat) => (
          <button
            type="button"
            data-tag={cat}
            class:list={[
              'cat-pill',
              {
                'acc-projects': cat === 'IA',
                'acc-blog': cat === 'Tech',
                'acc-about': cat === 'Lead',
                'acc-contact': cat === 'Business',
              },
            ]}
            aria-pressed="false"
          >
            <span>{BLOG_CATEGORIES[lang][cat]}</span>
          </button>
        ))
      }
    </div>

    <section class="mt-12">
      <ul id="archive">
        {
          all.map((post, index) => (
            <li
              class="py-5 border-t border-[color:var(--color-rule)]"
              data-tags={post.data.category}
            >
              <ArticleCard
                entry={post}
                variant="sm"
                lang={lang}
                headingLevel={2}
                seriesContext={seriesIndex.get(post.id)}
                loading={index === 0 ? 'eager' : undefined}
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </li>
          ))
        }
        <li class="border-t border-[color:var(--color-rule)]"></li>
      </ul>
      <p
        id="empty"
        class="hidden mt-6 text-[13px] text-[color:var(--color-muted)]"
        aria-live="polite"
      >
        {tr.blogIndex.empty}
      </p>
    </section>
  </main>

  <Footer variant="blog" maxWidth="820px" lang={lang} />
</SiteLayout>

<style is:global>
  .cat-pill {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 2px 8px;
    cursor: pointer;
    font-family: var(--font-mono);
  }
  .chip-active {
    background: currentColor;
  }
  .chip-active > span {
    color: var(--color-bg);
  }
</style>

<script>
  function init() {
    const filters = document.getElementById('filters');
    const posts = document.querySelectorAll<HTMLLIElement>(
      '#archive li[data-tags]'
    );
    const empty = document.getElementById('empty');
    if (!filters || !empty) return;
    filters.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('button[data-tag]');
      if (!btn) return;
      filters.querySelectorAll('button').forEach((x) => {
        x.classList.remove('chip-active');
        x.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('chip-active');
      btn.setAttribute('aria-pressed', 'true');

      const tag = btn.dataset.tag!;
      let shown = 0;
      posts.forEach((li) => {
        const tags = li.dataset.tags ?? '';
        const show = tag === 'all' || tags.includes(tag);
        li.classList.toggle('hidden', !show);
        if (show) shown++;
      });
      empty.classList.toggle('hidden', shown > 0);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
